{
  "name": "agents-pool",
  "version": "0.3.0",
  "description": "Autonomous agent pools for the software development lifecycle: a task goes in, a reviewed branch and merge request description come out.",
  "type": "module",
  "bin": {
    "agentpool": "dist/cli.js"
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "commander": "^12.1.0",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
